# Database Connection (sqlite for zero-config local, postgresql:// for production PostgreSQL/Neon/Supabase)
DATABASE_URL=sqlite:///./tech_stack_predictor.db

# GitHub API Token (Optional, increases GitHub API rate limits from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Gemini API Key (Required for server-side qualitative career AI feedback)
GEMINI_API_KEY=

# Secret key for signing JWT tokens
JWT_SECRET=super-secret-developer-tech-stack-key-2026

# Frontend API URL configuration (Used by Vite)
VITE_API_BASE_URL=http://localhost:8000
